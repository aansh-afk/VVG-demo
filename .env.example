# ---------------------------------------------------------------------------
# WASL Global Franchisee Marketing Cooperative Portal — environment
#
# EVERY VARIABLE BELOW IS OPTIONAL. The portal boots, seeds itself and runs
# fully (sign-up, dashboards, events, approvals, messaging, AI composer) with
# no configuration at all. Set these only when you want to harden it.
# ---------------------------------------------------------------------------

# 1) SESSION SIGNING KEY  (recommended for production)
# Any long random string. If unset, a per-boot key is generated, which means
# sessions are dropped whenever the server restarts.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 2) DURABLE STORAGE  (recommended for production / Vercel)
# Unset  -> data is persisted to ./.data/db.json (durable on any Node host)
#           and falls back to in-memory when the filesystem is read-only.
# Set    -> data is persisted to Postgres. Any provider works (Vercel Postgres,
#           Neon, Supabase, RDS). The single table is created automatically.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 3) FIRST SUPER ADMIN
# The account that is created on first boot. Change these before going live —
# and change the password immediately after the first sign-in.
SUPER_ADMIN_EMAIL=admin@wasl-global.org
SUPER_ADMIN_PASSWORD=ChangeMe!2026

# 4) PUBLIC SITE URL (used in generated email drafts and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
